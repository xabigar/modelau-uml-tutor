# Server-side defaults (optional). The server key/model are only used after a
# student unlocks them with SERVER_DEFAULT_PASSWORD in the LLM settings panel.
PORT=3000
HOST=0.0.0.0

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o

# Password students enter in the settings panel to unlock the server key.
SERVER_DEFAULT_PASSWORD=

